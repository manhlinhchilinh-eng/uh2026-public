# Copy thành .env.development.local (đã bị .gitignore chặn) để `npm run dev` dùng project dev.
# Lấy giá trị bằng: firebase apps:sdkconfig WEB --project sodaubai-dev
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sodaubai-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sodaubai-dev
VITE_FIREBASE_STORAGE_BUCKET=sodaubai-dev.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Hoặc dùng Firebase Emulator (firebase emulators:start --only auth,firestore):
# VITE_USE_FIREBASE_EMULATOR=true

# Chỉ bật khi THẬT SỰ cần chạy dev trên dữ liệu thật:
# VITE_ALLOW_PROD_IN_DEV=true
